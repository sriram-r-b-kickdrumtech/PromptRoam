# LLM (required)
OPENAI_API_KEY=

# Weather (free tier) — used for forecasts / rescheduling
OPENWEATHERMAP_API_KEY=

# RapidAPI key — used by RapidAPI MCP (and expanded in MCP_ARGS as ${RAPIDAPI_API_KEY})
RAPIDAPI_API_KEY=

# MCP gateway: use either RapidAPI MCP (npx) or local PromptRoam MCP server (python).
# Option A — RapidAPI MCP: use {{HOST}} and set MCP_*_HOSTS or .mcp_secrets.
# Option B — Local MCP (APIs registered in config/api_registry.json, docs from internet):
#   MCP_COMMAND=python
#   MCP_ARGS=["scripts/mcp_server_promptroam.py"]
#   (RAPIDAPI_API_KEY and OPENWEATHERMAP_API_KEY used by the server)
MCP_COMMAND=npx
MCP_ARGS=["mcp-remote", "https://mcp.rapidapi.com", "--header", "x-api-host: {{HOST}}", "--header", "x-api-key: ${RAPIDAPI_API_KEY}"]
# Per-category API hosts (comma-separated, up to 3). On error the next host in the same category is tried.
# MCP_FLIGHTS_HOSTS=flights-sky.p.rapidapi.com,other-flights.p.rapidapi.com,third-flights.p.rapidapi.com
# MCP_HOTELS_HOSTS=booking-com.p.rapidapi.com,hotels-com.p.rapidapi.com
# MCP_ACTIVITIES_HOSTS=tripadvisor-data.p.rapidapi.com,get-your-guide.p.rapidapi.com
# Optional: if RapidAPI MCP exposes different tool names, set e.g. MCP_TOOL_FLIGHTS=search
# MCP_TOOL_FLIGHTS=search_flights
# MCP_TOOL_HOTELS=search_hotels
# MCP_TOOL_ACTIVITIES=search_activities
# Optional: SSE instead of stdio (if you run a bridge that exposes RapidAPI MCP over SSE)
# MCP_SERVER_URL=
# MCP cache: set to 1 after verifying MCP works (scripts/test_mcp_and_cache.py). When 0, no Redis cache for MCP.
# MCP_CACHE_ENABLED=0

# Redis cache (Phase 9) — separate instance so existing cluster is untouched
# Start with: redis-server --port 6380
REDIS_HOST=localhost
REDIS_PORT=6380
# Or set full URL to override:
# REDIS_URL=redis://localhost:6380/0
